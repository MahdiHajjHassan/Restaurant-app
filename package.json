{
  "name": "restaurant-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "node scripts/db/migrate-test.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "psql -U postgres -h localhost -d restaurant_platform_dev -v ON_ERROR_STOP=1 -f scripts/db/seed.sql",
    "db:seed:media": "node scripts/seed-media.ts",
    "fixtures": "node scripts/make-image-fixtures.mjs",
    "perf:seed": "node scripts/perf/seed-perf-menu.ts",
    "perf:serve": "next start --port 3200",
    "perf:measure": "node scripts/perf/lighthouse.mjs",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "comment:overrides": [
    "sharp: Next pins ^0.34.5, but 0.34.x carries libvips CVEs (GHSA-f88m-g3jw-g9cj).",
    "This product resizes photos uploaded by restaurant owners, so image-decoding",
    "CVEs are directly reachable, not theoretical. Pinned to the patched line.",
    "postcss: Next bundles a nested 8.4.31 with three advisories; our own copy is",
    "already patched. Both are drop-in patch upgrades within the same major."
  ],
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.25"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
