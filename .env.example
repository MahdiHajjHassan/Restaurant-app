# Copy to .env.local and fill in. .env.local is gitignored.
#
# Two database URLs on purpose:
#
#   DATABASE_URL           the application connects as app_user, an unprivileged
#                          role that CANNOT bypass Row-Level Security. This is
#                          our second tenant-isolation layer and it only works
#                          if the runtime role is genuinely unprivileged.
#
#   MIGRATION_DATABASE_URL migrations need DDL, so they run as the owner.
#                          Never used at runtime.
#
# Run scripts/db/bootstrap.sql once to create the roles and databases.

DATABASE_URL="postgresql://app_user:app_dev_password@localhost:5432/restaurant_platform_dev"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_platform_dev"
TEST_DATABASE_URL="postgresql://app_user:app_dev_password@localhost:5432/restaurant_platform_test"
TEST_MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_platform_test"

# Where the platform itself lives. Tenant sites resolve by Host header; any host
# that is not a known tenant domain and not this one is a 404.
# Admin is served from app.<PLATFORM_DOMAIN> and never from a tenant domain, so
# session cookies stay scoped to a single origin.
PLATFORM_DOMAIN="localhost:3000"

# Local disk in development, Cloudflare R2 in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
